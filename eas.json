{
  "cli": {
    "version": ">= 23.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://future-pressroom-ai-production.up.railway.app/api",
        "EXPO_PUBLIC_SITE_URL": "https://www.futurepressroom.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://future-pressroom-ai-production.up.railway.app/api",
        "EXPO_PUBLIC_SITE_URL": "https://www.futurepressroom.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://future-pressroom-ai-production.up.railway.app/api",
        "EXPO_PUBLIC_SITE_URL": "https://www.futurepressroom.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}